Options -Indexes
RewriteEngine On
RewriteBase /smartbooks-server/api/

# Never expose backend internals or retired route files directly over HTTP.
RewriteRule ^(?:includes|routes|vendor)/ - [F,L,NC]

<FilesMatch "(^\.|\.env|\.sql$|composer\.(json|lock)$)">
    Require all denied
</FilesMatch>

# Route every API URL through the secured front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
